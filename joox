/* ============================================================
 * 七、apicx 搜索与歌曲详情
 * ============================================================ */

function pickLinks(detail) {
  return (detail && detail["播放链接"]) || null;
}

function hasPlayableLink(detail) {
  const links = pickLinks(detail);
  if (!links) return false;
  const keys = Object.keys(links);
  for (let i = 0; i < keys.length; i++) {
    const value = links[keys[i]];
    if (value && String(value).length > 10) return true;
  }
  return false;
}

function splitArtists(artist) {
  const raw = decodeEntities(artist);
  if (!raw) return [];
  return raw
    .split(/[,，、/&]|feat\.?/i)
    .map(function (name) {
      return normalize(name);
    })
    .filter(Boolean);
}

// 最长公共子序列占比，用于兼容简繁 / 细微标题差异
function textSimilarity(a, b) {
  const n = a.length;
  const m = b.length;
  if (!n || !m) return 0;
  if (a === b) return 1;
  let prev = new Array(m + 1);
  let cur = new Array(m + 1);
  for (let j = 0; j <= m; j++) prev[j] = 0;
  for (let i = 1; i <= n; i++) {
    cur[0] = 0;
    const ca = a.charAt(i - 1);
    for (let j = 1; j <= m; j++) {
      cur[j] =
        ca === b.charAt(j - 1)
          ? prev[j - 1] + 1
          : prev[j] > cur[j - 1]
          ? prev[j]
          : cur[j - 1];
    }
    const tmp = prev;
    prev = cur;
    cur = tmp;
  }
  return prev[m] / Math.max(n, m);
}

function isSameSong(item, detail) {
  if (!detail) return false;
  const targetMid = String(item.songmid || "").toLowerCase();
  const detailMid = String(detail.songmid || "").toLowerCase();
  if (targetMid && detailMid && targetMid === detailMid) return true;

  const t1 = normalize(item.title);
  const t2 = normalize(detail["歌曲名称"]);
  if (!t1 || !t2) return false;

  // 标题允许简繁差异：长度接近且相似度够高即视为同一首
  const titleOk =
    t1 === t2 ||
    (Math.abs(t1.length - t2.length) <= 2 && textSimilarity(t1, t2) >= 0.75);
  if (!titleOk) return false;

  const list1 = splitArtists(item.artist);
  const list2 = splitArtists(detail["歌手"]);
  if (!list1.length || !list2.length) return true;
  for (let i = 0; i < list1.length; i++) {
    for (let j = 0; j < list2.length; j++) {
      if (list1[i] === list2[j] || textSimilarity(list1[i], list2[j]) >= 0.7) {
        return true;
      }
    }
  }
  return false;
}

async function fetchDetailByKeyword(keyword, index) {
  try {
    const json = await request({
      token: readToken(),
      msg: keyword,
      n: index || 1,
    });
    if (json && json.code == 200 && json.data && hasPlayableLink(json.data)) {
      return json.data;
    }
  } catch (e) {
    // 单次尝试失败不抛出，交给上层换关键词重试
  }
  return null;
}

/**
 * 获取歌曲详情（含播放地址、歌词），带缓存与多级兜底
 * strict 为 true 时只接受歌名/歌手（或 songmid）匹配的结果
 */
async function fetchDetail(musicItem, strict) {
  const cacheKey = String((musicItem && musicItem.id) || "");
  const cached = cacheKey ? DETAIL_CACHE[cacheKey] : null;
  if (cached && Date.now() - cached.time < CACHE_TTL) return cached.data;

  const title = decodeEntities(musicItem.title);
  const artist = mainArtist(musicItem.artist);
  const attempts = [];

  if (title) {
    attempts.push({ keyword: artist ? title + " " + artist : title, index: 1 });
  }
  if (musicItem.keyword && musicItem.indexInSearch) {
    attempts.push({
      keyword: String(musicItem.keyword),
      index: parseInt(musicItem.indexInSearch, 10) || 1,
    });
  }
  if (title && artist) {
    attempts.push({ keyword: title, index: 1 });
  }

  let fallback = null;
  let matched = false;
  const tried = Object.create(null);
  const startedAt = Date.now();

  for (let i = 0; i < attempts.length; i++) {
    // 沙箱单次调用 10 秒超时，多级兜底时控制总耗时
    if (i > 0 && Date.now() - startedAt > 6000) break;

    const tryKey = attempts[i].keyword + "#" + attempts[i].index;
    if (tried[tryKey]) continue;
    tried[tryKey] = true;

    const detail = await fetchDetailByKeyword(
      attempts[i].keyword,
      attempts[i].index
    );
    if (!detail) continue;
    if (isSameSong(musicItem, detail)) {
      fallback = detail;
      matched = true;
      break;
    }
    if (!fallback && !strict) fallback = detail;
  }

  if (!fallback || (strict && !matched)) {
    throw new Error("JOOX 未找到可用音源，请更换关键词或稍后重试");
  }

  if (cacheKey) {
    DETAIL_CACHE[cacheKey] = { time: Date.now(), data: fallback };
  }
  return fallback;
}

/* ============================================================
 * 八、搜索
 * ============================================================ */

async function searchMusic(query, page) {
  const keyword = String(query || "").trim();
  // 接口不支持翻页（一次返回全部结果），第二页起直接结束
  if (!keyword || page > 1) {
    return { isEnd: true, data: [] };
  }

  let json;
  try {
    json = await request({ token: readToken(), msg: keyword });
  } catch (e) {
    throw new Error("JOOX 搜索请求失败：" + (e && e.message ? e.message : e));
  }

  const payload = json ? json.data : null;
  const songs = payload
    ? payload.songs || (Array.isArray(payload) ? payload : [])
    : [];

  const data = [];
  songs.forEach(function (it, i) {
    if (!it) return;
    const title = decodeEntities(it["歌曲名称"]);
    if (!title) return;
    const songmid = String(it.songmid || "");
    const songId = String(it["歌曲ID"] || "");
    data.push({
      id: songmid || songId || "joox_" + i,
      title: title,
      artist: decodeEntities(it["歌手"]),
      album: decodeEntities(it["专辑"]),
      duration: parseDuration(it["时长"]),
      artwork: "",
      songmid: songmid,
      songId: songId,
      keyword: keyword,
      indexInSearch: parseInt(it["序号"], 10) || i + 1,
    });
  });

  // 去重：同一首歌常因不同专辑 / 歌手顺序重复出现，按「歌名 + 歌手集合」只保留最靠前的一条
  const seen = Object.create(null);
  const unique = [];
  data.forEach(function (item) {
    const key =
      normalize(item.title) + "|" + splitArtists(item.artist).sort().join(",");
    if (seen[key]) return;
    seen[key] = true;
    unique.push(item);
  });

  return { isEnd: true, data: unique };
}

async function searchSheets(query, page) {
  const keyword = String(query || "").trim();
  const current = Math.max(1, Number(page) || 1);
  if (!keyword) return { isEnd: true, data: [] };

  const size = 30;
  const json = await wxJson("/fcgi-bin/category_search", {
    cid: 10041,
    music: b64En(keyword),
    type: 3,
    sin: (current - 1) * size,
    ein: current * size,
  });

  const list = json.result || [];
  return {
    isEnd: (Number(json.sum) || 0) <= current * size || !list.length,
    data: list.map(wxSheetToItem),
  };
}

/* ============================================================
 * 九、播放地址 / 歌词 / 歌曲信息
 * ============================================================ */

async function mediaFromSearch(musicItem, quality) {
  const detail = await fetchDetail(
    musicItem,
    !!(musicItem.needExact || musicItem.mid)
  );
  const links = pickLinks(detail);
  if (!links) throw new Error("JOOX 未返回播放地址");

  const chain = QUALITY_CHAIN[quality] || QUALITY_CHAIN.standard;
  let url = "";
  for (let i = 0; i < chain.length; i++) {
    const candidate = links[chain[i]];
    if (candidate && String(candidate).length > 10) {
      url = String(candidate);
      break;
    }
  }

  if (!url) {
    const keys = Object.keys(links);
    for (let i = 0; i < keys.length; i++) {
      if (links[keys[i]]) {
        url = String(links[keys[i]]);
        break;
      }
    }
  }

  if (!url) throw new Error("JOOX 暂无可用播放地址（可能受版权限制）");

  return {
    url: url.replace(/^http:\/\//i, "https://"),
    quality: quality || "standard",
    headers: {
      "User-Agent": UA,
      Referer: "https://www.joox.com/",
    },
  };
}

// 微信音乐协议兜底：按 mid + 音质拼文件名，换取临时 vkey
function wxQualityOrder(start) {
  const idx = WX_QUALITY_ORDER.indexOf(start);
  if (idx < 0) return ["standard", "low"];
  return WX_QUALITY_ORDER.slice(idx);
}

// 微信音乐接口会返回多个 CDN server，但并非每个都能取到该 vkey
async function wxExpressUrls(mid, quality) {
  const file = WX_QUALITY_FILE[quality] || WX_QUALITY_FILE.standard;
  const filename = file.s + mid + file.e;

  const xml = await wxFetch("/fcgi-bin/music_express", {
    cid: 352,
    authst: "",
    qq: 0,
    guid: "0",
    nettype: 1020,
    musicname: filename,
  });

  const vkey = decodeEntities(pdfh(xml, "vkey&&Text"));
  if (!vkey) return [];

  const servers = [];
  const re = /<server>\s*(https?:\/\/[^<\s]+)\s*<\/server>/gi;
  let match;
  while ((match = re.exec(xml))) {
    const host = match[1].replace(/\s+/g, "");
    if (servers.indexOf(host) < 0) servers.push(host);
  }

  const urls = [];
  servers.slice(0, 2).forEach(function (host) {
    // 优先 https，部分 CDN 不支持再回落到 http
    if (/^http:\/\//i.test(host)) {
      urls.push(
        host.replace(/^http:\/\//i, "https://") +
          filename +
          "?vkey=" +
          vkey +
          "&guid=0"
      );
    }
    urls.push(host + filename + "?vkey=" + vkey + "&guid=0");
  });
  return urls;
}

// 校验地址是否真的能取到音频，避免把 401/404 的地址交给播放器
async function isPlayableUrl(url) {
  try {
    const res = await axios.head(url, {
      headers: {
        "User-Agent": UA,
        Referer: "https://www.joox.com/",
      },
      timeout: 3000,
      validateStatus: function () {
        return true;
      },
    });
    const status = res ? Number(res.status) : 0;
    if (!status) return true;
    if (status === 405 || status === 501) return true; // 不支持 HEAD，交给播放器判断
    return status >= 200 && status < 400;
  } catch (e) {
    return true; // 网络层异常不作为地址无效
  }
}

async function mediaFromWx(musicItem, quality) {
  const mid = musicItem.mid || musicItem.songmid;
  if (!mid) throw new Error("JOOX 暂无可用的备用音源");

  const startQuality = pickWxQuality(musicItem, quality || "standard");
  const order = wxQualityOrder(startQuality);
  let lastErr = null;

  for (let i = 0; i < order.length; i++) {
    let urls = [];
    try {
      urls = await wxExpressUrls(mid, order[i]);
    } catch (e) {
      lastErr = e;
      continue;
    }

    for (let j = 0; j < urls.length; j++) {
      if (await isPlayableUrl(urls[j])) {
        return {
          url: urls[j],
          quality: order[i],
          headers: {
            "User-Agent": UA,
            Referer: "https://www.joox.com/",
          },
        };
      }
    }
    lastErr = new Error("JOOX 播放地址不可用（" + order[i] + "）");
  }

  throw lastErr || new Error("JOOX 暂无可用播放地址（可能受版权限制）");
}

async function getMediaSource(musicItem, quality) {
  let primary = null;
  try {
    primary = await mediaFromSearch(musicItem, quality);
    if (await isPlayableUrl(primary.url)) return primary;
  } catch (e) {
    // 搜索接口失败或无版权，走备用通道
  }

  try {
    return await mediaFromWx(musicItem, quality);
  } catch (e) {
    if (primary) return primary;
    throw e;
  }
}

async function getLyric(musicItem) {
  try {
    const detail = await fetchDetail(
      musicItem,
      !!(musicItem.needExact || musicItem.mid)
    );
    const lrc = detail ? detail["歌词内容"] || detail.lyric : "";
    if (lrc) return { rawLrc: String(lrc) };
  } catch (e) {
    // 搜索接口失败时走微信音乐协议
  }

  const gl = musicItem.songId || musicItem.id;
  if (gl) {
    try {
      const xml = await wxFetch("/fcgi-bin/3g_lyric", {
        cid: 111,
        gt: 1,
        gl: gl,
        music: b64En(musicItem.title),
        singer: b64En(musicItem.artist),
        album: b64En(musicItem.album),
      });
      const lrc = b64Text(pdfh(xml, "txt&&Text"));
      if (lrc) return { rawLrc: lrc };
    } catch (e) {
      // 忽略，统一抛出无歌词
    }
  }

  throw new Error("JOOX 暂无该歌曲歌词");
}

async function getMusicInfo(musicItem) {
  try {
    const detail = await fetchDetail(
      musicItem,
      !!(musicItem.needExact || musicItem.mid)
    );
    return {
      title: decodeEntities(detail["歌曲名称"]) || musicItem.title,
      artist: decodeEntities(detail["歌手"]) || musicItem.artist,
      album: decodeEntities(detail["专辑"]) || musicItem.album,
      duration: parseDuration(detail["时长"]) || musicItem.duration,
      songmid: String(detail.songmid || musicItem.songmid || ""),
      songId: String(detail["歌曲ID"] || musicItem.songId || ""),
    };
  } catch (e) {
    return {};
  }
}

