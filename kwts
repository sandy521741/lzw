/* ============ 简单内存缓存（15 分钟） ============ */
const CACHE_TTL = 15 * 60 * 1000;
const _cache = {};
function cacheGet(key) {
  const c = _cache[key];
  if (c && (Date.now() - c.time) < CACHE_TTL) return c.data;
  return null;
}
function cacheSet(key, data) { _cache[key] = { time: Date.now(), data: data }; }

/* ============ 网络层 ============ */
async function httpGet(url, headers) {
  if (!_axios) throw new Error('axios 不可用');
  const res = await _axios.get(url, { headers: headers || {}, timeout: TIMEOUT });
  return res && res.data;
}
async function httpPost(url, body, headers) {
  if (!_axios) throw new Error('axios 不可用');
  const res = await _axios.post(url, body, { headers: headers || {}, timeout: TIMEOUT });
  return res && res.data;
}

/* Supabase Edge GET（重试 3 次） */
async function edgeGet(path) {
  const url = path.indexOf('http') === 0 ? path : API_BASE + path;
  let lastErr = null;
  for (let i = 0; i < 3; i++) {
    try {
      const data = await httpGet(url, EDGE_HEADERS);
      if (data && typeof data === 'object') {
        if (data.error) throw new Error((data.error && data.error.message) || '服务响应错误');
        return data;
      }
      throw new Error('服务响应格式错误');
    } catch (e) { lastErr = e; }
  }
  throw lastErr || new Error('网络请求失败');
}

/* 酷我代理（POST kuwo-proxy，重试 3 次） */
async function callKuwo(body) {
  let lastErr = null;
  for (let i = 0; i < 3; i++) {
    try {
      const data = await httpPost(API_BASE + '/functions/v1/kuwo-proxy', body, JSON_HEADERS);
      if (data && typeof data === 'object' && (data.code === undefined || data.code === 200 || data.code === '200')) {
        return data;
      }
      throw new Error((data && data.message) || '服务响应错误');
    } catch (e) { lastErr = e; }
  }
  throw lastErr || new Error('网络请求多次尝试后失败');
}

/* ============ 数据映射 ============ */
function upgradeCover(pic) {
  return String(pic || '').replace(/(img\d\.kuwo\.cn\/star\/albumcover\/)(?:120|300|240)(\/)/, '$1500$2');
}
function fixCover(pic) {
  pic = upgradeCover(String(pic || '').trim());
  if (!pic) return '';
  if (pic.indexOf('https') === 0) return pic;
  if (pic.indexOf('//') === 0) return 'https:' + pic;
  return pic.replace(/^http:\/\//, 'https://');
}
/* 后端接口时长单位不统一（recSonglist 为毫秒、playlistSongList 为秒）：统一为毫秒 */
function normalizeDuration(d) {
  d = parseInt(d) || 0;
  if (d > 0 && d < 30000) return d * 1000;
  return d;
}
function mapSong(s) {
  if (!s) return null;
  const rid = String(s.rid != null ? s.rid : (s.id != null ? s.id : '')).replace(/^kuwo_/, '');
  if (!rid) return null;
  return {
    id: rid,
    rid: rid,
    title: String(s.name || '未知歌曲'),
    artist: String(s.artist || '未知歌手'),
    album: String(s.album || ''),
    artwork: fixCover(s.pic || s.cover || s.img || ''),
    duration: normalizeDuration(s.duration),
  };
}
function mapPlaylist(p) {
  if (!p || (p.id == null || p.id === '')) return null;
  return {
    id: String(p.id),
    title: String(p.name || '未知歌单'),
    coverImg: fixCover(p.cover || ''),
    artwork: fixCover(p.cover || ''),
    playCount: parseInt(p.playCount) || 0,
    worksNumber: parseInt(p.songCount != null ? p.songCount : p.trackCount) || 0,
    artist: String(p.author || p.creator || '聆听精选'),
    description: String(p.intro || ''),
  };
}
function mapBook(b) {
  if (!b || (b.id == null || b.id === '')) return null;
  return {
    id: String(b.id),
    title: String(b.title || '未知专辑'),
    artist: String(b.author || b.narrator || '未知作者'),
    artwork: fixCover(b.cover || ''),
    description: String(b.description || '').slice(0, 300),
  };
}

/* ============ 听书分类（kuwo-classify / kuwo-books / kuwo-albums，缓存） ============ */
/* 分类结构：sections = [{categoryId:'2', name:'有声小说', child:[{classifyId:'1546', name:'都市传说'}, ...]}, ...]
   分类标签 id 格式：'bkc:<classifyId>:<categoryId>' */
async function fetchBookClassify() {
  const cached = cacheGet('bookClassify');
  if (cached) return cached;
  const d = await edgeGet('/functions/v1/kuwo-classify');
  const sections = ((d && d.sections) || [])
    .map(function (s) {
      return {
        categoryId: String((s && s.categoryId) || '2'),
        name: String((s && s.name) || ''),
        child: ((s && s.child) || [])
          .map(function (c) {
            return (c && c.classifyId != null && c.name)
              ? { classifyId: String(c.classifyId), name: String(c.name) }
              : null;
          })
          .filter(Boolean),
      };
    })
    .filter(function (s) { return s.child.length; });
  if (sections.length) cacheSet('bookClassify', sections);
  return sections;
}

/* 每日推荐（酷我听书首页书单，缓存） */
async function fetchBookHome() {
  const cached = cacheGet('bookHome');
  if (cached) return cached;
  const d = await edgeGet('/functions/v1/kuwo-books');
  const books = ((d && d.books) || []).map(mapBookSheet).filter(Boolean);
  if (books.length) cacheSet('bookHome', books);
  return books;
}

/* 分类下的听书专辑（分页） */
async function fetchBookAlbums(classifyId, categoryId, page) {
  const d = await edgeGet('/functions/v1/kuwo-albums?classifyId=' + encodeURIComponent(classifyId) +
    '&pn=' + page + '&rn=' + PAGE_SIZE_SHEET + '&categoryId=' + encodeURIComponent(categoryId || '2') + '&sortType=tsScore');
  return ((d && d.books) || []).map(mapBookSheet).filter(Boolean);
}

/* ============ 听书榜单（kuwo-rank-tabs / kuwo-rank-data，缓存） ============ */
/* 结构与「one-酷我听书」官网一致：热播榜/口碑榜/畅销榜/VIP会员榜 + 各分类热播榜 */
async function fetchRankTabs() {
  const cached = cacheGet('rankTabs');
  if (cached) return cached;
  const d = await edgeGet('/functions/v1/kuwo-rank-tabs');
  const tabs = ((d && d.tabs) || [])
    .map(function (t) {
      return {
        id: String((t && t.id) || ''),
        name: String((t && t.name) || ''),
        tags: ((t && t.tags) || [])
          .map(function (g) {
            return (g && g.id != null) ? { id: String(g.id), name: String(g.name || '总榜') } : null;
          })
          .filter(Boolean),
      };
    })
    .filter(function (t) { return t.id && t.tags.length; });
  if (tabs.length) cacheSet('rankTabs', tabs);
  return tabs;
}

/* 榜单书目（分页，带 rank 排名） */
async function fetchRankBooks(tabId, tagId, page) {
  const d = await edgeGet('/functions/v1/kuwo-rank-data?tabId=' + encodeURIComponent(tabId) +
    '&tagId=' + encodeURIComponent(tagId) + '&pn=' + page + '&rn=' + PAGE_SIZE_SHEET);
  const list = ((d && d.list) || []).map(function (b) {
    const m = mapBookSheet(b);
    if (m && b.rank != null) m.rank = parseInt(b.rank) || 0;
    return m;
  }).filter(Boolean);
  return { books: list, total: parseInt(d && d.total) || 0 };
}

/* 书籍 -> 歌单卡片（id 加 kwa: 前缀，详情页据此走章节列表） */
function mapBookSheet(b) {
  if (!b || (b.id == null || b.id === '')) return null;
  return {
    id: 'kwa:' + String(b.id),
    title: String(b.title || '未知作品'),
    artist: String(b.author || b.narrator || '未知主播'),
    coverImg: fixCover(b.cover || ''),
    artwork: fixCover(b.cover || ''),
    worksNumber: parseInt(b.songNum) || 0,
    description: String(b.description || '').slice(0, 200),
  };
}

/* ============ 专辑（听书）章节 ============ */
async function fetchAlbumInfo(albumId) {
  albumId = String(albumId || '');
  if (!albumId) return { chapters: [], meta: {} };
  const ck = 'kwa_' + albumId;
  const cached = cacheGet(ck);
  if (cached) return cached;
  const data = await edgeGet('/functions/v1/kuwo-albuminfo?albumId=' + encodeURIComponent(albumId));
  /* 重要：保持接口原始顺序（与酷我听书官网集数顺序一致）。
     不要按章节 id 排序——id 是资源 id，与集数无关，排序会导致乱序 */
  const chapters = (data && data.chapters) || [];
  const result = { chapters: chapters, meta: (data && data.meta) || {} };
  cacheSet(ck, result);
  return result;
}

async function fetchBangMenu() {
  const cached = cacheGet('bangMenu');
  if (cached) return cached;
  const d = await callKuwo({ action: 'bangMenu' });
  const groups = ((d && d.categories) || []).map(function (c) {
    return {
      title: String((c && c.name) || '榜单'),
      data: ((c && c.list) || [])
        .filter(function (b) { return b && b.bangId != null; })
        .map(function (b) {
          return {
            id: 'kwb:' + String(b.bangId),
            title: String(b.name || '榜单'),
            coverImg: fixCover(b.pic || ''),
            artwork: fixCover(b.pic || ''),
            description: String(b.intro || ''),
          };
        }),
    };
  }).filter(function (g) { return g.data.length; });
  if (groups.length) cacheSet('bangMenu', groups);
  return groups;
}

/* ============ 插件定义 ============ */
module.exports = {
  platform: '酷我听书',
  author: '诗酒趁年华',
  version: '1.3.0',
  /* 托管后填入本文件的 URL 即可开启在线更新，例如：srcUrl: 'https://example.com/lingting.js' */
  srcUrl: '',
  primaryKey: ['id', 'rid'],
  cacheControl: 'no-cache',
  defaultSearchType: 'music',
  supportedSearchType: ['music', 'album', 'sheet'],
  description: '酷我音乐 / 听书榜单歌单广场 / 有声书',

  /* ---------- 搜索 ---------- */
  async search(query, page, type) {
    query = String(query || '').trim();
    page = parseInt(page) || 1;
    if (!query) return { isEnd: true, data: [] };

    if (type === 'music') {
      const d = await callKuwo({ action: 'searchMusic', word: query, pn: page - 1, rn: PAGE_SIZE_MUSIC });
      const songs = ((d && d.songs) || []).map(mapSong).filter(Boolean);
      return { isEnd: songs.length < PAGE_SIZE_MUSIC, data: songs };
    }
    if (type === 'album') {
      /* 听书专辑（酷我有声书），点进详情为章节列表，可逐集播放 */
      const d = await edgeGet('/functions/v1/kuwo-search?keyword=' + encodeURIComponent(query) + '&pn=' + (page - 1) + '&rn=' + PAGE_SIZE_ALBUM);
      const books = ((d && d.books) || []).map(mapBook).filter(Boolean);
      return { isEnd: books.length < PAGE_SIZE_ALBUM, data: books };
    }
    if (type === 'sheet') {
      const d = await callKuwo({ action: 'searchPlaylist', word: query, pn: page - 1, rn: PAGE_SIZE_SHEET });
      const pls = ((d && d.playlists) || []).map(mapPlaylist).filter(Boolean);
      return { isEnd: pls.length < PAGE_SIZE_SHEET, data: pls };
    }
    return { isEnd: true, data: [] };
  },

  /* ---------- 播放地址 ---------- */
  async getMediaSource(musicItem, quality) {
    const rid = String((musicItem && (musicItem.rid || musicItem.id)) || '').replace(/^kuwo_/, '');
    if (!rid) return null;
    const q = QUALITY_MAP[quality] || '320';
    const order = [q].concat(QUALITY_ORDER.filter(function (x) { return x !== q; }));
    for (let i = 0; i < order.length; i++) {
      try {
        const d = await edgeGet('/functions/v1/kuwo-play?rid=' + encodeURIComponent(rid) + '&quality=' + order[i]);
        if (d && d.url) return { url: String(d.url) };
      } catch (e) { /* 尝试下一档音质 */ }
    }
    return null;
  },

  /* ---------- 歌词 ---------- */
  async getLyric(musicItem) {
    const rid = String((musicItem && (musicItem.rid || musicItem.id)) || '').replace(/^kuwo_/, '');
    if (!rid) return null;
    try {
      const d = await edgeGet('/functions/v1/kuwo-play?rid=' + encodeURIComponent(rid));
      return { rawLrc: (d && typeof d.lyric === 'string') ? d.lyric : '' };
    } catch (e) { return null; }
  },

  /* ---------- 歌单详情 ---------- */
  async getMusicSheetInfo(sheetItem, page) {
    page = parseInt(page) || 1;
    const sid = String((sheetItem && sheetItem.id) || '');
    /* 听书歌单（kwa: 前缀）：详情为章节列表 */
    if (sid.indexOf('kwa:') === 0) {
      const info = await fetchAlbumInfo(sid.slice(4));
      const chapters = info.chapters || [];
      const meta = info.meta || {};
      const start = (page - 1) * PAGE_SIZE_CHAPTER;
      const artwork = fixCover(meta.cover || sheetItem.artwork || sheetItem.coverImg || '');
      const musicList = chapters.slice(start, start + PAGE_SIZE_CHAPTER).map(function (ch, i) {
        return {
          id: String(ch.id),
          rid: String(ch.id),
          title: String(ch.title || ('第' + (start + i + 1) + '集')),
          artist: String(meta.author || sheetItem.artist || '未知主播'),
          album: String(meta.name || sheetItem.title || ''),
          artwork: artwork,
          duration: (parseInt(ch.duration) || 0) * 1000,
        };
      });
      const result = { isEnd: start + PAGE_SIZE_CHAPTER >= chapters.length, musicList: musicList };
      if (page <= 1) {
        result.sheetItem = {
          title: String(meta.name || sheetItem.title || ''),
          artist: String(meta.author || sheetItem.artist || ''),
          artwork: artwork,
          description: String(meta.description || sheetItem.description || ''),
          worksNumber: chapters.length,
        };
      }
      return result;
    }
    /* 普通音乐歌单 */
    const pid = sid;
    if (!pid) return { isEnd: true, musicList: [] };
    const d = await callKuwo({ action: 'playlistSongList', id: String(pid), pn: page - 1, rn: PAGE_SIZE_SHEET });
    const musicList = ((d && d.songs) || []).map(mapSong).filter(Boolean);
    const result = { isEnd: musicList.length < PAGE_SIZE_SHEET, musicList: musicList };
    if (page <= 1) {
      result.sheetItem = {
        title: sheetItem.title,
        artwork: sheetItem.artwork || sheetItem.coverImg || '',
        worksNumber: parseInt(d && d.total) || musicList.length,
      };
    }
    return result;
  },

  /* ---------- 专辑（听书）详情：章节列表 ---------- */
  async getAlbumInfo(albumItem, page) {
    page = parseInt(page) || 1;
    const albumId = albumItem && albumItem.id;
    if (!albumId) return { isEnd: true, musicList: [] };
    const info = await fetchAlbumInfo(albumId);
    const chapters = info.chapters || [];
    const start = (page - 1) * PAGE_SIZE_CHAPTER;
    const pageCh = chapters.slice(start, start + PAGE_SIZE_CHAPTER);
    const meta = info.meta || {};
    const artwork = fixCover(meta.cover || albumItem.artwork || '');
    const musicList = pageCh.map(function (ch, i) {
      return {
        id: String(ch.id),
        rid: String(ch.id),
        title: String(ch.title || ('第' + (start + i + 1) + '集')),
        artist: String(meta.author || albumItem.artist || '未知作者'),
        album: String(meta.name || albumItem.title || ''),
        artwork: artwork,
        duration: (parseInt(ch.duration) || 0) * 1000,
      };
    });
    const result = { isEnd: start + PAGE_SIZE_CHAPTER >= chapters.length, musicList: musicList };
    if (page <= 1) {
      result.albumItem = {
        title: String(meta.name || albumItem.title || ''),
        artist: String(meta.author || albumItem.artist || ''),
        artwork: artwork,
        description: String(meta.description || albumItem.description || ''),
        worksNumber: chapters.length,
      };
    }
    return result;
  },

  /* ---------- 榜单 ---------- */
  async getTopLists() {
    return fetchBangMenu();
  },

  async getTopListDetail(topListItem, page) {
    page = parseInt(page) || 1;
    const bangId = String((topListItem && topListItem.id) || '').replace(/^kwb:/, '');
    if (!bangId) return Object.assign({}, topListItem, { musicList: [], isEnd: true });
