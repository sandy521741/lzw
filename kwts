  /* ---------- 歌单广场（酷我听书官网完整体系：精选 + 榜单 + 分类） ---------- */
  async getRecommendSheetTags() {
    let tabs = [];
    try { tabs = await fetchRankTabs(); } catch (e) { }
    let sections = [];
    try { sections = await fetchBookClassify(); } catch (e) { }

    const byName = {};
    tabs.forEach(function (t) { byName[t.name] = t; });

    /* pinned·精选（与官网一致）：每日推荐 / 热播榜 / 口碑榜 / 畅销榜 / VIP会员榜·总榜 / VIP新书榜 */
    const pinned = [{ id: 'bkhome', title: '每日推荐' }];
    ['热播榜', '口碑榜', '畅销榜'].forEach(function (n) {
      const t = byName[n];
      if (t) pinned.push({ id: 'kwr:' + t.id + ':' + t.tags[0].id, title: n });
    });
    const vip = byName['VIP会员榜'];
    if (vip) {
      pinned.push({ id: 'kwr:' + vip.id + ':' + vip.tags[0].id, title: 'VIP会员榜·总榜' });
      const nx = vip.tags.filter(function (g) { return g.name.indexOf('新书') >= 0; })[0];
      if (nx) pinned.push({ id: 'kwr:' + vip.id + ':' + nx.id, title: 'VIP新书榜' });
    }

    /* 分组：每个主题先「榜单」后「分类」，按官网板块顺序排列 */
    const data = [];
    const usedTabs = {};
    sections.forEach(function (s) {
      const tab = byName[s.name] || (s.name === '历史人文' ? byName['历史'] : null);
      if (tab) {
        data.push({
          title: s.name + '·榜单',
          data: tab.tags.map(function (g) { return { id: 'kwr:' + tab.id + ':' + g.id, title: g.name }; }),
        });
        usedTabs[tab.id] = 1;
      }
      data.push({
        title: s.name + '·分类',
        data: s.child.map(function (c) { return { id: 'bkc:' + c.classifyId + ':' + s.categoryId, title: c.name }; }),
      });
    });
    /* 未归入主题的榜单 tab（如热播榜/口碑榜/畅销榜）单独成组，避免遗漏 */
    tabs.forEach(function (t) {
      if (!usedTabs[t.id]) {
        data.push({
          title: t.name + '·榜单',
          data: t.tags.map(function (g) { return { id: 'kwr:' + t.id + ':' + g.id, title: g.name }; }),
        });
      }
    });

    return { pinned: pinned, data: data };
  },

  async getRecommendSheetsByTag(tag, page) {
    page = parseInt(page) || 1;
    const tagId = String((tag && tag.id) || '');

    /* 听书榜单：'kwr:<tabId>:<tagId>' */
    if (tagId.indexOf('kwr:') === 0) {
      const parts = tagId.split(':');
      const r = await fetchRankBooks(parts[1], parts[2], page);
      return { isEnd: r.books.length < PAGE_SIZE_SHEET, data: r.books };
    }

    /* 听书分类：'bkc:<classifyId>:<categoryId>' */
    if (tagId.indexOf('bkc:') === 0) {
      const parts = tagId.split(':');
      const books = await fetchBookAlbums(parts[1], parts[2], page);
      return { isEnd: books.length < PAGE_SIZE_SHEET, data: books };
    }

    /* 默认 / 每日推荐 -> 酷我听书首页书单 */
    const books = await fetchBookHome();
    const start = (page - 1) * PAGE_SIZE_SHEET;
    return { isEnd: start + PAGE_SIZE_SHEET >= books.length, data: books.slice(start, start + PAGE_SIZE_SHEET) };
  },

  /* ---------- 导入酷我歌单链接 ---------- */
  async importMusicSheet(urlLike) {
    const m = String(urlLike || '').match(/(\d{3,})/);
    if (!m) return null;
    const pid = m[1];
    const d = await callKuwo({ action: 'playlistSongList', id: pid, pn: 0, rn: 1000 });
    return ((d && d.songs) || []).map(mapSong).filter(Boolean);
  },
};
